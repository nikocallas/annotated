{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Annotated",
  "version": "1.9.1",
  "key": "",
  "description": "Highlight any sentence or clip any moment, then dispute it, fact-check it, or add context. Always linked back to the source.",
  "permissions": ["sidePanel", "activeTab", "storage", "scripting", "tabs", "offscreen", "tabCapture"],
  "host_permissions": [
    "https://annotatedextension.com/*",
    "https://www.annotatedextension.com/*",
    "https://cpqmjujhcwpavrsjadjz.supabase.co/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://annotatedextension.com/*",
      "https://www.annotatedextension.com/*"
    ]
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "public/icons/icon-16.png",
      "48": "public/icons/icon-48.png",
      "128": "public/icons/icon-128.png"
    },
    "default_title": "Open Annotated"
  },
  "icons": {
    "16": "public/icons/icon-16.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  }
}
