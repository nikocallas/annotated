{
  "manifest_version": 3,
  "name": "Annotated",
  "version": "1.3.2",
  "description": "Clip 90-second highlights from any video, podcast, or article. Annotate. Share. Always linked back to the source.",
  "permissions": ["sidePanel", "activeTab", "storage", "scripting", "tabs", "offscreen"],
  "host_permissions": ["https://annotatedextension.com/*"],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "public/icons/icon-16.png",
      "48": "public/icons/icon-48.png",
      "128": "public/icons/icon-128.png"
    },
    "default_title": "Open Annotated"
  },
  "icons": {
    "16": "public/icons/icon-16.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  }
}
