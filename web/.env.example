# Supabase backend for the annotated API.
# When both vars are set, the Express API persists users / annotations /
# follows / comments / claims to Supabase Postgres. When either is missing,
# the API silently falls back to in-memory storage (suitable for local smoke
# tests but not durable across Vercel cold starts).
SUPABASE_URL=https://cpqmjujhcwpavrsjadjz.supabase.co
SUPABASE_ANON_KEY=sb_publishable_Ibpg9ePSkS0IrmQZbseKPg_MqBZ5Die

# Vite-exposed copies of the same Supabase project for the browser. The
# frontend brokers Google / X OAuth through Supabase Auth and needs these to
# be set at build time. When they're absent the login page falls back to the
# demo auth path.
VITE_SUPABASE_URL=https://cpqmjujhcwpavrsjadjz.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Ibpg9ePSkS0IrmQZbseKPg_MqBZ5Die

# Optional: override the default 5000 port for `npm run dev`.
# PORT=5000
