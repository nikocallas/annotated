# Supabase backend for the Annotated API. Production requires all three
# server values and fails explicitly (without an in-memory fallback) if the
# durable store is unavailable.
SUPABASE_URL=https://cpqmjujhcwpavrsjadjz.supabase.co
SUPABASE_ANON_KEY=sb_publishable_Ibpg9ePSkS0IrmQZbseKPg_MqBZ5Die

# Required server-only credential for validated database mutations, signed
# Storage uploads, media inspection, rate limiting, and moderation. Retrieve
# it from the provider; never paste a real value into this file or a VITE_* var.
SUPABASE_SERVICE_ROLE_KEY=replace-in-provider-settings

# Vite-exposed copies of the same Supabase project for the browser. The
# frontend brokers Google / X OAuth through Supabase Auth and needs these to
# be set at build time. When absent, sign-in is disabled rather than minting
# an unverifiable demo identity.
VITE_SUPABASE_URL=https://cpqmjujhcwpavrsjadjz.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Ibpg9ePSkS0IrmQZbseKPg_MqBZ5Die

# Optional: override the default 5000 port for `npm run dev`.
# PORT=5000

# Comma-separated additional exact preview origins allowed by API CORS.
# VERCEL_URL and VERCEL_BRANCH_URL are added automatically on Vercel.
# ALLOWED_ORIGINS=https://annotated-git-resubmission.example.vercel.app

# Comma-separated Supabase Auth user UUIDs allowed to review/update claims.
MODERATOR_AUTH_IDS=replace-with-owner-auth-user-id

# Vercel supplies this bearer token to the daily orphan-media cleanup cron.
CRON_SECRET=replace-with-long-random-value

# Optional additional salt for hashed rate-limit subjects. Server-side only.
RATE_LIMIT_SALT=replace-with-long-random-value

# Chrome Web Store listing URL for the Annotated extension. The published
# listing URL is baked into the client as the default; setting this overrides
# it (useful for staging or a relocated listing). The bundled
# /downloads/annotated-extension.zip remains only as an internal fallback if
# this is set to an empty string — visible copy never directs users to it.
# VITE_CHROME_WEB_STORE_URL=https://chromewebstore.google.com/detail/annotated/eaealcbiidjigfndjchchbnjdjicbajb

# ---- Support contact form (POST /api/support) ----
# RESEND_API_KEY is required for the /support page to deliver email. When it
# is missing the API returns 503 and the form shows a friendly error. Set
# this in Vercel project settings for the production deploy.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
#
# Destination address for support messages. Server-side only; never exposed
# to the browser.
SUPPORT_TO_EMAIL=support@annotatedextension.com
#
# Sender. Defaults to Resend's sandbox sender, which is fine for testing but
# rate-limited and may be filtered. In production, configure a verified
# sending domain in Resend and use it here, e.g.
# SUPPORT_FROM_EMAIL=Annotated Support <support@annotatedextension.com>
# SUPPORT_FROM_EMAIL=Annotated Support <onboarding@resend.dev>
